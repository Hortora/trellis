{
  "name": "trellis-shell",
  "version": "0.1.0",
  "description": "Trellis — Electron shell for the epic delivery engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "jest": "^30.4.2"
  },
  "build": {
    "appId": "io.hortora.trellis",
    "productName": "Trellis",
    "files": [
      "main.js",
      "java-server.js",
      "preload.js",
      "window-manager.js",
      "layout-store.js"
    ],
    "extraResources": [
      {
        "from": "../sidecar/target/quarkus-app",
        "to": "quarkus-app"
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}
